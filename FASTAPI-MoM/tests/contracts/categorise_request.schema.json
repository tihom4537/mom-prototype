{
  "$defs": {
    "AgendaInput": {
      "description": "One agenda item as the caller holds it. `template` names one of the nine\nfixed statutory sheets; omit it for a user-added agenda, which is classified.",
      "properties": {
        "id": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "title": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "description": {
          "default": "",
          "maxLength": 5000,
          "title": "Description",
          "type": "string"
        },
        "template": {
          "anyOf": [
            {
              "enum": [
                "statutory_1",
                "statutory_2",
                "statutory_3",
                "statutory_4",
                "statutory_5",
                "statutory_6",
                "statutory_7",
                "statutory_8",
                "statutory_9"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Template"
        }
      },
      "required": [
        "id",
        "title"
      ],
      "title": "AgendaInput",
      "type": "object"
    }
  },
  "properties": {
    "agendas": {
      "items": {
        "$ref": "#/$defs/AgendaInput"
      },
      "maxItems": 50,
      "minItems": 1,
      "title": "Agendas",
      "type": "array"
    }
  },
  "required": [
    "agendas"
  ],
  "title": "CategoriseRequest",
  "type": "object"
}

{
  "$defs": {
    "AgendaInput": {
      "description": "One user-added agenda item as the caller holds it. The nine statutory\nagendas are never sent: the server always prints their fixed sheets first.",
      "properties": {
        "id": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "title": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "description": {
          "default": "",
          "maxLength": 5000,
          "title": "Description",
          "type": "string"
        }
      },
      "required": [
        "id",
        "title"
      ],
      "title": "AgendaInput",
      "type": "object"
    },
    "MeetingInput": {
      "properties": {
        "title": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "date": {
          "default": "",
          "maxLength": 50,
          "title": "Date",
          "type": "string"
        },
        "time": {
          "default": "",
          "maxLength": 50,
          "title": "Time",
          "type": "string"
        },
        "venue": {
          "default": "",
          "maxLength": 200,
          "title": "Venue",
          "type": "string"
        }
      },
      "required": [
        "title"
      ],
      "title": "MeetingInput",
      "type": "object"
    }
  },
  "description": "Everything needed to print the notesheet: the meeting header plus the\nuser-added agendas in the order they should appear after the nine\nstatutory sheets. Each is classified and printed on its category sheet.",
  "properties": {
    "meeting": {
      "$ref": "#/$defs/MeetingInput"
    },
    "agendas": {
      "items": {
        "$ref": "#/$defs/AgendaInput"
      },
      "maxItems": 60,
      "title": "Agendas",
      "type": "array"
    },
    "orientation": {
      "default": "landscape",
      "enum": [
        "landscape",
        "portrait"
      ],
      "title": "Orientation",
      "type": "string"
    }
  },
  "required": [
    "meeting"
  ],
  "title": "ProceedingsPdfRequest",
  "type": "object"
}

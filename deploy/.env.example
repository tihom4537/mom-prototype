# Copy to /opt/mom/.env on the VM (chmod 600). Never commit the real file.
GEMINI_API_KEY=
SARVAMAI_API_KEY=
LLM_MODEL_NAME=gemini-3.1-flash-lite
# Local Postgres (audit tables). Any long random string; only used inside the compose network.
POSTGRES_PASSWORD=
# JWT (RS256). Public key PEM on one line with literal \n; see deploy/README.md
JWT_PUBLIC_KEY=
JWT_AUDIENCE=mom-api
# Token the frontend container uses to call the backend (mint with scripts/make_test_token.py)
FRONTEND_API_TOKEN=
